@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@if (_isOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-light">
                    <h5 class="modal-title text-primary d-flex align-items-center">
                        <i class="ti @(IsEditMode ? "ti-edit" : "ti-plus") me-2 fs-4"></i>
                        @(IsEditMode ? $"Cập Nhật Tài Khoản Ngân Hàng - {Model.Number}" : "Thêm Mới Tài Khoản Ngân Hàng")
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>

                <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="modal-body py-4">
                        <div class="row g-3">
                            <!-- Mã Ngân hàng (Number) -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Mã Tài Khoản <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control" @bind-Value="Model.Number" placeholder="VD: BANK-VCB-01" />
                                <ValidationMessage For="() => Model.Number" class="text-danger small mt-1" />
                            </div>

                            <!-- Tên hiển thị / Tên gợi nhớ (Name) -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Tên Gợi Nhớ / Tên Tài Khoản <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control" @bind-Value="Model.Name" placeholder="VD: TK Thu Cọc Madame Lân - Vietcombank" />
                                <ValidationMessage For="() => Model.Name" class="text-danger small mt-1" />
                            </div>

                            <!-- Tên Ngân Hàng (BankName) -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Tên Ngân Hàng & Chi Nhánh <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control" @bind-Value="Model.BankName" placeholder="VD: Vietcombank (VCB) - Chi nhánh Đà Nẵng" />
                                <ValidationMessage For="() => Model.BankName" class="text-danger small mt-1" />
                            </div>

                            <!-- Số Tài Khoản (AccountNo) -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Số Tài Khoản <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control font-monospace" @bind-Value="Model.AccountNo" placeholder="VD: 0041000888999" />
                                <ValidationMessage For="() => Model.AccountNo" class="text-danger small mt-1" />
                            </div>

                            <!-- Chủ Tài Khoản (AccountName) -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Chủ Tài Khoản (Tên thụ hưởng) <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control text-uppercase" @bind-Value="Model.AccountName" placeholder="VD: CÔNG TY TNHH MADAME LÂN" />
                                <ValidationMessage For="() => Model.AccountName" class="text-danger small mt-1" />
                            </div>

                            <!-- Mã Số Thuế (TaxCode) -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Mã Số Thuế</label>
                                <InputText class="form-control" @bind-Value="Model.TaxCode" placeholder="VD: 0401234567" />
                                <ValidationMessage For="() => Model.TaxCode" class="text-danger small mt-1" />
                            </div>

                            <!-- Loại Tổ Chức (OrgType) -->
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Loại Tổ Chức</label>
                                <InputSelect class="form-select" @bind-Value="Model.OrgType">
                                    <option value="Nội bộ">Nội bộ</option>
                                    <option value="Đối tác">Đối tác</option>
                                    <option value="Hướng dẫn viên">Hướng dẫn viên</option>
                                    <option value="Khác">Khác</option>
                                </InputSelect>
                            </div>

                            <!-- Mô Tả (Description) -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Mục Đích Sử Dụng / Ghi Chú</label>
                                <InputTextArea class="form-control" @bind-Value="Model.Description" rows="2" placeholder="VD: Dùng nhận cọc booking, thanh toán chiết khấu đối tác..." />
                                <ValidationMessage For="() => Model.Description" class="text-danger small mt-1" />
                            </div>

                            <!-- Trạng Thái (IsActive) -->
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox class="form-check-input" id="bankIsActive" @bind-Value="Model.IsActive" />
                                    <label class="form-check-label fw-semibold" for="bankIsActive">
                                        Kích hoạt sử dụng tài khoản này
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Audit Metadata Info -->
                        <div class="mt-4 p-3 bg-light rounded border">
                            <div class="row text-muted small">
                                <div class="col-sm-6">
                                    <i class="ti ti-user me-1"></i> Người thực hiện: <strong class="text-dark">@CurrentLoginId</strong>
                                </div>
                                <div class="col-sm-6 text-sm-end">
                                    <i class="ti ti-clock me-1"></i> Thời gian: <strong class="text-dark">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Close">
                            <i class="ti ti-x me-1"></i> Hủy
                        </button>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="ti ti-device-floppy me-1"></i> @(IsEditMode ? "Lưu Thay Đổi" : "Tạo Mới")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback<BankInfoViewModel> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    private bool _isOpen = false;
    private bool IsEditMode => Model.Id > 0;
    private BankInfoViewModel Model { get; set; } = new();

    private string CurrentLoginId => Configuration["AppConfig:CurrentLoginId"] ?? "admin";

    public void ShowCreate()
    {
        Model = new BankInfoViewModel
        {
            Id = 0,
            IsActive = true,
            OrgType = "Nội bộ",
            CreatedBy = CurrentLoginId,
            ModifiedBy = CurrentLoginId,
            CreatedOn = DateTime.Now,
            ModifiedOn = DateTime.Now
        };
        _isOpen = true;
        StateHasChanged();
    }

    public void ShowEdit(BankInfoViewModel item)
    {
        Model = item.Clone();
        Model.ModifiedBy = CurrentLoginId;
        Model.ModifiedOn = DateTime.Now;
        _isOpen = true;
        StateHasChanged();
    }

    public void Close()
    {
        _isOpen = false;
        OnClosed.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        Model.Number = Model.Number.Trim();
        Model.Name = Model.Name.Trim();
        Model.BankName = Model.BankName.Trim();
        Model.AccountNo = Model.AccountNo.Trim();
        Model.AccountName = Model.AccountName.Trim().ToUpper();
        Model.TaxCode = Model.TaxCode?.Trim();
        Model.Description = Model.Description?.Trim();
        Model.ModifiedBy = CurrentLoginId;
        Model.ModifiedOn = DateTime.Now;

        if (Model.Id == 0)
        {
            Model.CreatedBy = CurrentLoginId;
            Model.CreatedOn = DateTime.Now;
        }

        _isOpen = false;
        await OnSaved.InvokeAsync(Model);
    }
}
