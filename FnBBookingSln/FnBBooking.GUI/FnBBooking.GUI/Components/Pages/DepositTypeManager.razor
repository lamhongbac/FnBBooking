@page "/deposit-type-manager"
@using FnBBooking.GUI.Components.Common
@using FnBBooking.GUI.Components.Modals
@using FnBBooking.GUI.Controllers
@using FnBBooking.GUI.Helpers
@using FnBBooking.GUI.ViewModels

<PageTitle>Quản Lý Hình Thức Cọc - FnBBooking</PageTitle>

<!-- [ Header & Action ] start -->
<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h4 class="mb-1 text-primary d-flex align-items-center">
                    <i class="ti ti-cash me-2 fs-3"></i> Quản Lý Hình Thức Đặt Cọc
                </h4>
                <p class="text-muted mb-0">Quản lý danh mục phương thức và hình thức thanh toán tiền đặt cọc giữ bàn.</p>
            </div>
            <div>
                <button class="btn btn-primary" @onclick="() => depositTypeModal?.Open()">
                    <i class="ti ti-plus me-1"></i> Thêm Hình Thức Mới
                </button>
            </div>
        </div>
    </div>
</div>
<!-- [ Header & Action ] end -->

<!-- [ Alert Feedback ] start -->
@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ti ti-circle-check me-2 fs-5 align-middle"></i> @alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}
<!-- [ Alert Feedback ] end -->

<!-- [ Filter & Search Toolbar ] start -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <!-- Ô tìm kiếm (Text Search) -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="ti ti-search"></i></span>
                    <input type="text" class="form-control" placeholder="Tìm theo mã, tên hoặc mô tả hình thức..."
                           @bind="searchTerm" @onkeyup="HandleKeyUp" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Xóa từ khóa">
                            <i class="ti ti-x"></i>
                        </button>
                    }
                </div>
            </div>

            <!-- Dropdown lọc trạng thái (Status Filter) -->
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small text-nowrap mb-0">Trạng thái:</label>
                    <select class="form-select" @bind="selectedStatus">
                        <option value="All">Tất cả trạng thái</option>
                        <option value="Active">Đang hoạt động</option>
                        <option value="Inactive">Ngừng hoạt động</option>
                    </select>
                </div>
            </div>

            <!-- Nút Tìm kiếm (Query / Refresh data với tất cả parameters) -->
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="button" @onclick="DoSearch">
                    <i class="ti ti-search me-1"></i> Tìm kiếm
                </button>
            </div>

            <div class="col-md-2 text-md-end text-muted small">
                Tổng: <strong class="text-dark">@(controller?.PagerModel.TotalRows ?? 0)</strong> hình thức
            </div>
        </div>
    </div>
</div>
<!-- [ Filter & Search Toolbar ] end -->

<!-- [ Data Table ] start -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th style="cursor: pointer; width: 160px;" @onclick='() => Sort("Number")'>
                        Mã Hình Thức
                        @if (sortModel.ColName == "Number")
                        {
                            <i class="ti @(sortModel.Order == SortOrder.Ascending ? "ti-arrow-up" : "ti-arrow-down") ms-1 text-primary"></i>
                        }
                    </th>
                    <th style="cursor: pointer;" @onclick='() => Sort("Name")'>
                        Tên Hình Thức Đặt Cọc
                        @if (sortModel.ColName == "Name")
                        {
                            <i class="ti @(sortModel.Order == SortOrder.Ascending ? "ti-arrow-up" : "ti-arrow-down") ms-1 text-primary"></i>
                        }
                    </th>
                    <th style="cursor: pointer;" @onclick='() => Sort("Description")'>
                        Mô Tả
                        @if (sortModel.ColName == "Description")
                        {
                            <i class="ti @(sortModel.Order == SortOrder.Ascending ? "ti-arrow-up" : "ti-arrow-down") ms-1 text-primary"></i>
                        }
                    </th>
                    <th style="cursor: pointer; width: 140px;" class="text-center" @onclick='() => Sort("IsActive")'>
                        Trạng Thái
                        @if (sortModel.ColName == "IsActive")
                        {
                            <i class="ti @(sortModel.Order == SortOrder.Ascending ? "ti-arrow-up" : "ti-arrow-down") ms-1 text-primary"></i>
                        }
                    </th>
                    <th style="width: 140px;" class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (controller == null || controller.CurrentPageItems.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="ti ti-inbox fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy dữ liệu hình thức đặt cọc phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    int stt = (controller.PagerModel.PageIndex - 1) * controller.PagerModel.PageSize + 1;
                    @foreach (var item in controller.CurrentPageItems)
                    {
                        <tr>
                            <td class="text-center text-muted">@(stt++)</td>
                            <td>
                                <span class="badge bg-light-primary text-primary fw-semibold px-2 py-1">
                                    @item.Number
                                </span>
                            </td>
                            <td>
                                <strong class="text-dark">@item.Name</strong>
                            </td>
                            <td>
                                <span class="text-muted small">@item.Description</span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="ti ti-circle-check me-1"></i> Đang hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                        <i class="ti ti-circle-x me-1"></i> Ngừng hoạt động
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" title="Chỉnh sửa"
                                            @onclick="() => depositTypeModal?.Open(item)">
                                        <i class="ti ti-edit"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Xóa"
                                            @onclick="() => ConfirmDelete(item)">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- [ Pagination Component ] start -->
    @if (controller != null && controller.PagerModel.TotalRows > 0)
    {
        <div class="card-footer bg-white border-top py-3">
            <PaginationComponent Pager="@controller.PagerModel"
                                 OnPageChanged="HandlePageChanged"
                                 OnPageSizeChanged="HandlePageSizeChanged" />
        </div>
    }
    <!-- [ Pagination Component ] end -->
</div>
<!-- [ Data Table ] end -->

<!-- [ Modal Thêm / Chỉnh Sửa ] -->
<DepositTypeModal @ref="depositTypeModal" OnSave="HandleSave" />

<!-- [ Confirm Delete Modal ] -->
@if (itemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1056;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title d-flex align-items-center">
                        <i class="ti ti-alert-triangle me-2 fs-4"></i> Xác Nhận Xóa
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => itemToDelete = null"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-1">Bạn có chắc chắn muốn xóa hình thức cọc sau không?</p>
                    <div class="alert alert-light border mt-2 mb-0">
                        <strong>@itemToDelete.Number</strong> - @itemToDelete.Name
                    </div>
                    <small class="text-danger d-block mt-2">Lưu ý: Dữ liệu bị xóa sẽ không thể phục hồi.</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-3" @onclick="() => itemToDelete = null">Hủy</button>
                    <button type="button" class="btn btn-danger px-3" @onclick="ExecuteDelete">
                        <i class="ti ti-trash me-1"></i> Xóa Hình Thức
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DepositTypeModal? depositTypeModal;
    private PageDepositTypeController? controller;
    private List<DepositTypeViewModel> allItems = new();
    private SortModel sortModel = new() { ColName = "Number", Order = SortOrder.Ascending };
    private Dictionary<string, object> filterObject = new();

    private string searchTerm = string.Empty;
    private string selectedStatus = "All";
    private string? alertMessage;
    private DepositTypeViewModel? itemToDelete;

    protected override void OnInitialized()
    {
        LoadInitialData();
        InitializeController();
    }

    private void LoadInitialData()
    {
        allItems = new List<DepositTypeViewModel>
        {
            new() { Id = "1", Number = "Cash", Name = "Tiền mặt", Description = "Khách đặt cọc trực tiếp bằng tiền mặt tại quầy thu ngân", IsActive = true },
            new() { Id = "2", Number = "BankTransfer", Name = "Chuyển khoản ngân hàng", Description = "Chuyển khoản qua số tài khoản hoặc quét mã VietQR", IsActive = true },
            new() { Id = "3", Number = "POS_Card", Name = "Quẹt thẻ POS", Description = "Thanh toán qua máy POS bằng thẻ ATM / Visa / Mastercard", IsActive = true },
            new() { Id = "4", Number = "PaymentGateway", Name = "Cổng thanh toán Online", Description = "Cổng thanh toán OnePay / VNPay trực tuyến", IsActive = true }
        };
    }

    private void InitializeController()
    {
        filterObject.Clear();
        if (!string.IsNullOrWhiteSpace(searchTerm))
            filterObject[FilterKey.SearchKeyword] = searchTerm;

        if (selectedStatus != "All")
            filterObject[FilterKey.Status] = selectedStatus;

        controller = new PageDepositTypeController(allItems, sortModel, filterObject, 1, 10);
        controller.Filter();
    }

    private void DoSearch()
    {
        InitializeController();
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            DoSearch();
        }
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        DoSearch();
    }

    private void Sort(string colName)
    {
        if (sortModel.ColName == colName)
        {
            sortModel.Order = sortModel.Order == SortOrder.Ascending ? SortOrder.Descending : SortOrder.Ascending;
        }
        else
        {
            sortModel.ColName = colName;
            sortModel.Order = SortOrder.Ascending;
        }
        controller?.Filter();
    }

    private void HandlePageChanged(int pageIndex)
    {
        if (controller != null)
        {
            controller.PagerModel.PageIndex = pageIndex;
            controller.Filter();
        }
    }

    private void HandlePageSizeChanged(int pageSize)
    {
        if (controller != null)
        {
            controller.PagerModel.PageSize = pageSize;
            controller.PagerModel.PageIndex = 1;
            controller.Filter();
        }
    }

    private void HandleSave(DepositTypeViewModel model)
    {
        var existing = allItems.FirstOrDefault(x => x.Id == model.Id);
        if (existing != null)
        {
            existing.Number = model.Number;
            existing.Name = model.Name;
            existing.Description = model.Description;
            existing.IsActive = model.IsActive;
            existing.ModifiedOn = model.ModifiedOn;
            existing.ModifiedBy = model.ModifiedBy;
            alertMessage = $"Đã cập nhật thành công hình thức cọc '{model.Name}'.";
        }
        else
        {
            allItems.Insert(0, model);
            alertMessage = $"Đã thêm mới thành công hình thức cọc '{model.Name}'.";
        }

        controller?.Filter();
    }

    private void ConfirmDelete(DepositTypeViewModel item)
    {
        itemToDelete = item;
    }

    private void ExecuteDelete()
    {
        if (itemToDelete != null)
        {
            itemToDelete.IsDeleted = true;
            allItems.Remove(itemToDelete);
            alertMessage = $"Đã xóa hình thức cọc '{itemToDelete.Name}'.";
            itemToDelete = null;
            controller?.Filter();
        }
    }
}

