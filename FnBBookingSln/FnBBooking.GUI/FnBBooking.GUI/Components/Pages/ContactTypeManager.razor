@page "/contact-type-manager"
@inject IPageStateRegistryService PageStateRegistry
@using FnBBooking.GUI.Components.Common
@using FnBBooking.GUI.Components.Modals
@using FnBBooking.GUI.Controllers
@using FnBBooking.GUI.Helpers
@using FnBBooking.GUI.ViewModels

<PageTitle>Quản Lý Loại Khách / Liên Hệ - FnBBooking</PageTitle>

<!-- [ Header & Action ] start -->
<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h4 class="mb-1 text-primary d-flex align-items-center">
                    <i class="ti ti-users-group me-2 fs-3"></i> Quản Lý Loại Khách / Liên Hệ
                </h4>
                <p class="text-muted mb-0">Quản lý các nhóm đối tượng khách hàng, đối tác (KOL, Tour Guide, Travel Agency...) và chính sách hoa hồng.</p>
            </div>
            <div>
                <button class="btn btn-primary" @onclick="() => contactTypeModal?.ShowCreate()">
                    <i class="ti ti-plus me-1"></i> Thêm Loại Liên Hệ
                </button>
            </div>
        </div>
    </div>
</div>
<!-- [ Header & Action ] end -->

<!-- [ Alert Feedback ] start -->
@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ti ti-circle-check me-2 fs-5 align-middle"></i> @alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}
<!-- [ Alert Feedback ] end -->

<!-- [ Filter & Search Toolbar ] start -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <!-- Ô tìm kiếm (Text Search) -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="ti ti-search"></i></span>
                    <input type="text" class="form-control" placeholder="Tìm theo mã, tên hoặc mô tả loại đối tác..."
                           @bind="searchTerm" @onkeyup="HandleKeyUp" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Xóa từ khóa">
                            <i class="ti ti-x"></i>
                        </button>
                    }
                </div>
            </div>

            <!-- Dropdown lọc trạng thái (Status Filter) -->
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small text-nowrap mb-0">Trạng thái:</label>
                    <select class="form-select" @bind="selectedStatus">
                        <option value="All">Tất cả trạng thái</option>
                        <option value="Active">Đang hoạt động</option>
                        <option value="Inactive">Ngừng hoạt động</option>
                    </select>
                </div>
            </div>

            <!-- Nút Tìm kiếm (Query / Refresh data với tất cả parameters) -->
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="button" @onclick="DoSearch">
                    <i class="ti ti-search me-1"></i> Tìm kiếm
                </button>
            </div>

            <div class="col-md-2 text-md-end text-muted small">
                @if (pageController != null)
                {
                    <span>Tổng: <strong>@pageController.PagingInfo.TotalItems</strong> loại</span>
                }
            </div>
        </div>
    </div>
</div>
<!-- [ Filter & Search Toolbar ] end -->

<!-- [ Data Table ] start -->
<div class="card tbl-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 45px;" class="text-center">STT</th>
                        <th style="cursor: pointer; width: 140px;" @onclick='() => SortBy("Number")'>
                            MÃ ĐỐI TƯỢNG <i class="@GetSortIcon("Number")"></i>
                        </th>
                        <th style="cursor: pointer;" @onclick='() => SortBy("Name")'>
                            TÊN / NHÓM ĐỐI TƯỢNG <i class="@GetSortIcon("Name")"></i>
                        </th>
                        <th style="cursor: pointer; width: 130px;" class="text-center" @onclick='() => SortBy("HaveCommision")'>
                            HOA HỒNG <i class="@GetSortIcon("HaveCommision")"></i>
                        </th>
                        <th style="cursor: pointer; width: 130px;" class="text-end" @onclick='() => SortBy("CommissionRate1")'>
                            % SET MENU <i class="@GetSortIcon("CommissionRate1")"></i>
                        </th>
                        <th style="cursor: pointer; width: 130px;" class="text-end" @onclick='() => SortBy("CommissionRate2")'>
                            % A-LA-CARTE <i class="@GetSortIcon("CommissionRate2")"></i>
                        </th>
                        <th style="cursor: pointer; width: 120px;" class="text-center" @onclick='() => SortBy("IsActive")'>
                            TRẠNG THÁI <i class="@GetSortIcon("IsActive")"></i>
                        </th>
                        <th style="width: 120px;" class="text-center">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pageController == null || !pageController.CurrentPageData.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="ti ti-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy loại khách/liên hệ phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var startIndex = (pageController.PagingInfo.CurrentPage - 1) * pageController.PagingInfo.PageSize;
                        for (int i = 0; i < pageController.CurrentPageData.Count; i++)
                        {
                            var item = pageController.CurrentPageData[i];
                            var stt = startIndex + i + 1;
                            <tr>
                                <td class="text-center text-muted">@stt</td>
                                <td>
                                    <span class="badge bg-light-primary text-primary fw-semibold px-2 py-1">
                                        @item.Number
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-dark">@item.Name</strong>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.HaveCommision)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="ti ti-check me-1"></i> Có
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border px-2 py-1">
                                            Không
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.HaveCommision)
                                    {
                                        <span class="fw-semibold text-primary">@item.CommissionRate1.ToString("G29")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.HaveCommision)
                                    {
                                        <span class="fw-semibold text-primary">@item.CommissionRate2.ToString("G29")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="ti ti-circle-check me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="ti ti-circle-x me-1"></i> Ngừng
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="Chỉnh sửa"
                                                @onclick="() => contactTypeModal?.ShowEdit(item)">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Xóa"
                                                @onclick="() => ConfirmDelete(item)">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- [ Pagination Component ] start -->
    @if (pageController != null && pageController.PagingInfo.TotalPages > 0)
    {
        <div class="card-footer bg-white border-top py-2">
            <PaginationComponent Pager="@pageController.PagingInfo"
                                 OnPageChanged="HandlePageChange"
                                 OnPageSizeChanged="HandlePageSizeChange" />
        </div>
    }
    <!-- [ Pagination Component ] end -->
</div>
<!-- [ Data Table ] end -->

<!-- [ Modal Thêm / Chỉnh Sửa ] -->
<ContactTypeModal @ref="contactTypeModal" OnSaved="HandleSaved" />

<!-- [ Confirm Delete Modal ] -->
@if (deletingItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1056;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title d-flex align-items-center">
                        <i class="ti ti-alert-triangle me-2 fs-4"></i> Xác Nhận Xóa
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => deletingItem = null"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-1">Bạn có chắc chắn muốn xóa loại khách/liên hệ sau không?</p>
                    <div class="alert alert-light border mt-2 mb-0">
                        <strong>@deletingItem.Number</strong> - @deletingItem.Name
                    </div>
                    <small class="text-danger d-block mt-2">Dữ liệu sẽ được đánh dấu xóa mềm (IsDeleted = true).</small>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-3" @onclick="() => deletingItem = null">Hủy</button>
                    <button type="button" class="btn btn-danger px-3" @onclick="ExecuteDelete">
                        <i class="ti ti-trash me-1"></i> Xóa Loại
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string PageKey = "ContactTypeManager";
    private ContactTypeModal? contactTypeModal;
    private List<ContactTypeViewModel> allItems = new();
    private PageContactTypeController? pageController;

    private string searchTerm = string.Empty;
    private string selectedStatus = "All";
    private int pageSize = 10;
    private string? alertMessage;
    private ContactTypeViewModel? deletingItem;

    protected override void OnInitialized()
    {
        allItems = new List<ContactTypeViewModel>
        {
            new() { Id = 1, Number = "Individual", Name = "Khách hàng cá nhân", Description = "Cá nhân / cty book cho cá nhân, không có hoa hồng", HaveCommision = false, CommissionRate1 = 0, CommissionRate2 = 0, IsActive = true },
            new() { Id = 2, Number = "HotelResort", Name = "Khách sạn / Resort", Description = "Cá nhân làm trong khách sạn, resort giới thiệu khách đến dùng bữa", HaveCommision = true, CommissionRate1 = 15, CommissionRate2 = 10, IsActive = true },
            new() { Id = 3, Number = "TourGuide", Name = "Hướng dẫn viên (HDV)", Description = "HDV cá nhân kinh doanh du lịch", HaveCommision = true, CommissionRate1 = 15, CommissionRate2 = 10, IsActive = true },
            new() { Id = 4, Number = "TravelAgency", Name = "Công ty Lữ hành", Description = "Lữ hành: cty kinh doanh du lịch có giấy phép, có hoa hồng", HaveCommision = true, CommissionRate1 = 15, CommissionRate2 = 10, IsActive = true },
            new() { Id = 5, Number = "TGO", Name = "Tổ chức HDV (TGO)", Description = "Cty du lịch kinh doanh dựa trên khách hàng của HDV, có hoa hồng", HaveCommision = true, CommissionRate1 = 15, CommissionRate2 = 10, IsActive = true },
            new() { Id = 6, Number = "KOL_KOC", Name = "KOL / KOC", Description = "Các đối tượng khách mời, người ảnh hưởng", HaveCommision = false, CommissionRate1 = 0, CommissionRate2 = 0, IsActive = true }
        };

        var savedState = PageStateRegistry.GetOrCreateState(PageKey);
        if (savedState.IsInitialized)
        {
            searchTerm = savedState.SearchKeyword;
            selectedStatus = savedState.SelectedStatus;
            pageSize = savedState.PageSize;
        }

        var sortModel = new SortModel();
        sortModel.AddColumn("Number", isDefaultColumn: true);
        sortModel.AddColumn("Name");
        sortModel.AddColumn("HaveCommision");
        sortModel.AddColumn("CommissionRate1");
        sortModel.AddColumn("CommissionRate2");
        sortModel.AddColumn("IsActive");

        if (savedState.IsInitialized && !string.IsNullOrEmpty(savedState.SortedProperty))
        {
            sortModel.SortedProperty = savedState.SortedProperty;
            sortModel.SortedOrder = savedState.SortedOrder;
        }

        var filterDict = new Dictionary<string, object>
        {
            { FilterKey.SearchKeyword, searchTerm },
            { FilterKey.Status, selectedStatus }
        };

        int targetPage = savedState.IsInitialized ? savedState.CurrentPage : 1;
        pageController = new PageContactTypeController(allItems, sortModel, filterDict, targetPage, pageSize);
    }

    private void SaveCurrentPageState()
    {
        if (pageController == null) return;
        var state = PageStateRegistry.GetOrCreateState(PageKey);
        state.SearchKeyword = searchTerm;
        state.SelectedStatus = selectedStatus;
        state.CurrentPage = pageController.PagingInfo.CurrentPage;
        state.PageSize = pageController.PagingInfo.PageSize;
        state.SortedProperty = pageController.PageSortModel.SortedProperty;
        state.SortedOrder = pageController.PageSortModel.SortedOrder;
        PageStateRegistry.SetState(PageKey, state);
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            DoSearch();
        }
    }

    private void DoSearch()
    {
        if (pageController == null) return;
        pageController.FilterObject[FilterKey.SearchKeyword] = searchTerm;
        pageController.FilterObject[FilterKey.Status] = selectedStatus;
        pageController.Filter();
        pageController.SetupPage(1);
        SaveCurrentPageState();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        DoSearch();
    }

    private void SortBy(string prop)
    {
        if (pageController == null) return;
        pageController.PageSortModel.ApplySort(prop);
        pageController.DoSort();
        pageController.SetupPage(pageController.PagingInfo.CurrentPage);
        SaveCurrentPageState();
    }

    private string GetSortIcon(string prop)
    {
        if (pageController?.PageSortModel == null)
            return "ti ti-arrows-sort text-muted ms-1";

        if (!string.Equals(pageController.PageSortModel.SortedProperty, prop, StringComparison.OrdinalIgnoreCase))
            return "ti ti-arrows-sort text-muted ms-1";

        return pageController.PageSortModel.SortedOrder == SortOrder.Ascending
            ? "ti ti-sort-ascending text-primary ms-1"
            : "ti ti-sort-descending text-primary ms-1";
    }

    private void HandlePageChange(int page)
    {
        pageController?.GoToPage(page);
        SaveCurrentPageState();
    }

    private void HandlePageSizeChange(int newSize)
    {
        pageSize = newSize;
        pageController?.ChangePageSize(newSize);
        SaveCurrentPageState();
    }

    private void HandleSaved(ContactTypeViewModel savedItem)
    {
        if (savedItem.Id == 0)
        {
            savedItem.Id = allItems.Any() ? allItems.Max(b => b.Id) + 1 : 1;
            allItems.Insert(0, savedItem);
            alertMessage = $"Đã thêm mới loại đối tác '{savedItem.Name}' thành công!";
        }
        else
        {
            var index = allItems.FindIndex(b => b.Id == savedItem.Id);
            if (index >= 0)
            {
                allItems[index] = savedItem;
                alertMessage = $"Đã cập nhật loại đối tác '{savedItem.Name}' thành công!";
            }
        }

        if (pageController != null)
        {
            pageController.AllItems = allItems;
            pageController.RefreshPage();
            SaveCurrentPageState();
        }
    }

    private void ConfirmDelete(ContactTypeViewModel item)
    {
        deletingItem = item;
    }

    private void ExecuteDelete()
    {
        if (deletingItem != null)
        {
            deletingItem.IsDeleted = true;
            alertMessage = $"Đã xóa loại đối tác '{deletingItem.Name}' thành công!";
            deletingItem = null;

            if (pageController != null)
            {
                pageController.AllItems = allItems;
                pageController.RefreshPage();
                SaveCurrentPageState();
            }
        }
    }
}
